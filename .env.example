# Copy to .env and adjust. Relative paths are resolved from the repository root.
DATA_ROOT=data/hoi_dataset      # LeRobot HOI dataset: meta/, data/, mesh/, ground_plane/, support_surface/, videos/
WORK_DIR=outputs                # retargeted motion, checkpoints, evaluations
ENV_DIR=.venvs                  # Python environments created by scripts/setup
WEIGHTS_DIR=weights             # reconstruction model weights

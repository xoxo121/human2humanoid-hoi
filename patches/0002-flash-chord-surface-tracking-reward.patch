+def object_vertex_moments(mesh_path: str) -> tuple[np.ndarray, np.ndarray]:
+    """Mean and second moment E[v v^T] of an object mesh's vertices in its body frame (the ADD vertex set)."""
+    import trimesh
+
+    vertices = np.asarray(trimesh.load(mesh_path, force="mesh").vertices, dtype=np.float64)
+    return vertices.mean(axis=0), vertices.T @ vertices / len(vertices)
+

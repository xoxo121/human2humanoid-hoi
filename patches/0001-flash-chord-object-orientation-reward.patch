+def test_object_orientation_std_turns_the_object_term_into_a_pose_reward():
+    import warp as wp
+
+    from flash_chord.objectives.recon_body import compose_recon_body_objective
+
+    quarter_turn = wp.quat_from_axis_angle(wp.vec3(0.0, 0.0, 1.0), 0.5 * np.pi)
+    reference_joint_q = np.zeros((11, 10), dtype=np.float32)
+    reference_joint_q[:, 6] = 1.0
+    wrist_quat = np.zeros((22, 4), dtype=np.float32)
+    wrist_quat[:, 3] = 1.0
+    terms = {}
+    for std in (0.0, 0.5):
+        with wp.ScopedDevice("cpu"):
+            out = wp.zeros(12, dtype=wp.float32)
+            wp.launch(
+                compose_recon_body_objective,
+                dim=1,
+                inputs=[
+                    wp.array(
+                        [
+                            wp.transform_identity(),
+                            wp.transform(wp.vec3(1.0, 0.0, 0.0), wp.quat_identity()),
+                            wp.transform(wp.vec3(0.0, 1.0, 0.0), wp.quat_identity()),
+                            wp.transform(wp.vec3(2.1, 0.0, 0.0), quarter_turn),
+                        ],
+                        dtype=wp.transform,
+                    ),
+                    wp.zeros(10, dtype=wp.float32),
+                    wp.array([5], dtype=wp.int32),
+                    wp.zeros(1, dtype=wp.int32),
+                    wp.zeros(1, dtype=wp.int32),
+                    wp.zeros(1, dtype=wp.float32),
+                    wp.zeros(1, dtype=wp.float32),
+                    wp.zeros(1, dtype=wp.float32),
+                    wp.zeros(10, dtype=wp.float32),
+                    wp.array(reference_joint_q, dtype=wp.float32),
+                    wp.zeros(22, dtype=wp.vec3),
+                    wp.array(wrist_quat, dtype=wp.quat),
+                    wp.array([1, 2], dtype=wp.int32),
+                    wp.zeros(2, dtype=wp.vec3),
+                    wp.array([wp.quat_identity(), wp.quat_identity()], dtype=wp.quat),
+                    wp.array([7, 8], dtype=wp.int32),
+                    wp.array([7], dtype=wp.int32),
+                    wp.array([-1.0, -1.0], dtype=wp.float32),
+                    wp.array([1.0, 1.0], dtype=wp.float32),
+                    3,
+                    wp.array([[2.0, 0.0, 0.0]], dtype=wp.vec3),
+                    wp.array([wp.quat_identity()], dtype=wp.quat),
+                    0,
+                    11,
+                    4,
+                    10,
+                    2,
+                    1,
+                    0.3,
+                    0.4,
+                    1.0,
+                    0.2,
+                    0.2,
+                    0.4,
+                    std,
+                    wp.ones(12, dtype=wp.float32),
+                    0.02,
+                ],
+                outputs=[out, wp.zeros(1, dtype=wp.float32)],
+            )
+        terms[std] = out.numpy()[7]
+
+    position_factor = np.exp(-(0.1**2) / 0.2**2)
+    np.testing.assert_allclose(terms[0.0], position_factor, rtol=1.0e-5)
+    np.testing.assert_allclose(terms[0.5], position_factor * np.exp(-((0.5 * np.pi) ** 2) / 0.5**2), rtol=1.0e-4)
+
